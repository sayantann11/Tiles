{
  "name": "tiledesk-erp",
  "version": "1.0.0",
  "private": true,
  "description": "TileDesk: ERP for tile and sanitary showrooms (stock, billing, quotations, credit, purchases, expenses, leads, reports).",
  "type": "module",
  "scripts": {
    "dev": "node dev/server.mjs",
    "test:api": "node tests/api.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "test": "node tests/api.test.mjs && node tests/e2e.mjs",
    "db:init": "wrangler d1 execute tiledesk --remote --file=server/schema.sql",
    "deploy": "wrangler pages deploy public --project-name=tiledesk"
  },
  "devDependencies": {
    "wrangler": "^4.168.0"
  }
}
